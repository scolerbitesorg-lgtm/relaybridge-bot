# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Telegram Bot API Token from @BotFather (runs live menu commands, inline buttons, and admin-channel forwarding)
TELEGRAM_BOT_TOKEN=

# Telegram MTProto Userbot credentials from https://my.telegram.org (reads open/public channels without admin rights & forwards large videos/files)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_USERBOT_SESSION=

# Optional comma-separated Telegram numeric user IDs allowed to control the bot (leave blank to allow first owner)
TELEGRAM_ADMIN_IDS=

# Optional dashboard passcode to protect the web control center API routes
DASHBOARD_PASSCODE=
